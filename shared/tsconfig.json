{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "react": ["../combined_full_stack/node_modules/@types/react"],
      "react/jsx-runtime": ["../combined_full_stack/node_modules/@types/react/jsx-runtime.d.ts"]
    }
  },
  "include": ["./**/*.ts", "./**/*.tsx"]
}
