{
  "id": "p_db_migration",
  "name": "Legacy CRM Migration",
  "kind": "database-migration",
  "models": [
    {
      "id": "m_src",
      "name": "SourceDocument",
      "description": "Raw JSON file annotated with its purpose.",
      "fields": [
        { "id": "f_purpose", "name": "purpose", "type": "text", "optional": false, "description": "What this file contains" },
        { "id": "f_body", "name": "body", "type": "text", "optional": false, "description": "Full file text" }
      ]
    },
    {
      "id": "m_legacy",
      "name": "LegacyUser",
      "description": "One messy legacy CRM record (string booleans, DD/MM/YYYY dates, deprecated fields).",
      "fields": [
        { "id": "f_id", "name": "ID", "type": "int", "optional": false, "description": "Legacy primary key" },
        { "id": "f_fullname", "name": "FullName", "type": "text", "optional": false, "description": "Full name in one field" },
        { "id": "f_email", "name": "EMAIL_ADDR", "type": "text", "optional": false, "description": "Mixed-case email" },
        { "id": "f_signup", "name": "signup", "type": "text", "optional": false, "description": "DD/MM/YYYY signup date" },
        { "id": "f_street", "name": "addr_street", "type": "text", "optional": false, "description": "Street line" },
        { "id": "f_city", "name": "addr_city", "type": "text", "optional": true, "description": "City (sometimes missing)" },
        { "id": "f_active", "name": "is_active", "type": "text", "optional": false, "description": "Y/N flag" },
        { "id": "f_fax", "name": "fax", "type": "text", "optional": true, "description": "Deprecated — dropped by the mapping" }
      ]
    },
    {
      "id": "m_mig",
      "name": "MigrationInput",
      "description": "Auto-generated by the Combine Inputs step.",
      "auto": true,
      "fields": [
        { "id": "f_mapping", "name": "mapping", "type": "document", "optional": false, "description": "Field-mapping spec JSON" },
        { "id": "f_legacy_users", "name": "legacy_users", "type": "list[model]", "optional": false, "description": "Parsed legacy records", "ref": "m_legacy" }
      ]
    },
    {
      "id": "m_addr",
      "name": "Address",
      "description": "Nested address built from dotted target fields.",
      "fields": [
        { "id": "f_a_street", "name": "street", "type": "text", "optional": false, "description": "Street line" },
        { "id": "f_a_city", "name": "city", "type": "text", "optional": true, "description": "City, null when the legacy record had none" }
      ]
    },
    {
      "id": "m_user",
      "name": "MigratedUser",
      "description": "One record in the new schema, produced purely from the mapping spec.",
      "fields": [
        { "id": "f_user_id", "name": "user_id", "type": "int", "optional": false, "description": "New primary key" },
        { "id": "f_first", "name": "first_name", "type": "text", "optional": false, "description": "First word of FullName" },
        { "id": "f_last", "name": "last_name", "type": "text", "optional": false, "description": "Last word of FullName" },
        { "id": "f_mail", "name": "email", "type": "text", "optional": false, "description": "Lowercased email" },
        { "id": "f_signed", "name": "signed_up_at", "type": "datetime", "optional": false, "description": "ISO date (YYYY-MM-DD)" },
        { "id": "f_address", "name": "address", "type": "model", "optional": false, "description": "Nested address", "ref": "m_addr" },
        { "id": "f_active2", "name": "active", "type": "bool", "optional": false, "description": "Y/N → bool" },
        { "id": "f_plan", "name": "plan", "type": "text", "optional": false, "description": "Defaulted when absent in legacy data" }
      ]
    }
  ],
  "modules": [
    {
      "id": "mod_input_legacy",
      "kind": "input",
      "label": "Legacy Users",
      "inputType": "json",
      "outStructureId": "m_src",
      "cached": false,
      "avgMs": 90,
      "avgCostCents": 0
    },
    {
      "id": "mod_parse",
      "kind": "custom-code",
      "label": "Parse JSON Records",
      "note": "Custom TS function — raw JSON text → typed legacy records, no LLM cost.",
      "inStructureId": "m_src",
      "outStructureId": "m_legacy",
      "outIsList": true,
      "code": "(d) => JSON.parse(d.body)",
      "cached": false,
      "avgMs": 5,
      "avgCostCents": 0
    },
    {
      "id": "mod_input_mapping",
      "kind": "input",
      "label": "Field Mapping",
      "inputType": "json",
      "outStructureId": "m_src",
      "cached": false,
      "avgMs": 80,
      "avgCostCents": 0
    },
    {
      "id": "mod_combine",
      "kind": "combine",
      "label": "Combine Inputs",
      "note": "Builds {\"mapping\", \"legacy_users\"}",
      "inStructureId": "m_legacy",
      "outStructureId": "m_mig",
      "cached": false,
      "avgMs": 40,
      "avgCostCents": 0
    },
    {
      "id": "mod_migrate",
      "kind": "custom-code",
      "label": "Apply Field Mapping",
      "note": "Driven entirely by the mapping spec: transform registry, dotted targets nest, missing source → default else null, unmapped legacy fields dropped.",
      "inStructureId": "m_mig",
      "outStructureId": "m_user",
      "outIsList": true,
      "code": "(input) => {\n  const spec = JSON.parse(input.mapping.body).fields;\n  const transforms = {\n    lowercase: (v) => String(v).toLowerCase(),\n    first_word: (v) => String(v).trim().split(/\\s+/)[0],\n    last_word: (v) => String(v).trim().split(/\\s+/).pop(),\n    yn_to_bool: (v) => v === 'Y',\n    ddmmyyyy_to_iso: (v) => { const [d, m, y] = String(v).split('/'); return y + '-' + m + '-' + d; }\n  };\n  const setPath = (obj, path, v) => {\n    const keys = path.split('.');\n    let cur = obj;\n    for (const k of keys.slice(0, -1)) cur = cur[k] = cur[k] ?? {};\n    cur[keys[keys.length - 1]] = v;\n  };\n  return input.legacy_users.map((rec) => {\n    const out = {};\n    for (const [target, s] of Object.entries(spec)) {\n      const raw = s.source === undefined ? undefined : rec[s.source];\n      setPath(out, target, raw === undefined ? (s.default === undefined ? null : s.default) : s.transform ? transforms[s.transform](raw) : raw);\n    }\n    return out;\n  });\n}",
      "cached": false,
      "avgMs": 10,
      "avgCostCents": 0
    },
    {
      "id": "mod_output_db",
      "kind": "output",
      "label": "Migrated Users",
      "inStructureId": "m_user",
      "outStructureId": "m_user",
      "outIsList": true,
      "cached": false,
      "avgMs": 40,
      "avgCostCents": 0
    }
  ],
  "strategies": [
    { "id": "s_single_db", "kind": "single-llm", "name": "Single LLM Call", "enabled": true, "model": "deepseek-v3", "accuracy": 81, "latencyMs": 2900, "costCents": 6, "passRate": 92 },
    { "id": "s_rlm_db", "kind": "rlm", "name": "Recursive LM", "enabled": true, "model": "deepseek-v3", "accuracy": 90, "latencyMs": 8400, "costCents": 17, "passRate": 97 },
    { "id": "s_agent_db", "kind": "claude-code", "name": "Agent (Frontier)", "enabled": true, "model": "deepseek-v3", "accuracy": 97, "latencyMs": 24100, "costCents": 150, "passRate": 99 },
    { "id": "s_cheap_db", "kind": "cheap-agent", "name": "Agent (Cheap Model)", "enabled": true, "model": "deepseek-v3", "accuracy": 87, "latencyMs": 15600, "costCents": 11, "passRate": 93 }
  ],
  "docs": [
    { "name": "database_legacy_users.json", "type": "json", "label": "inference", "file": "database_migration/data/database_legacy_users.json" },
    { "name": "database_field_mapping.json", "type": "json", "label": "inference", "file": "database_migration/data/database_field_mapping.json" }
  ]
}
