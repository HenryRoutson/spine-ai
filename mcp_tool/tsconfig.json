{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@/*": ["../combined_full_stack/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "../combined_full_stack/node_modules"]
}
