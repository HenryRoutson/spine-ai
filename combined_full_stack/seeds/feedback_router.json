{
  "id": "p_feedback_router",
  "name": "Product Feedback Router",
  "kind": "product-ops",
  "models": [
    {
      "id": "m_item",
      "name": "FeedbackItem",
      "description": "One bullet of user feedback.",
      "fields": [
        {
          "id": "f_id",
          "name": "feedback_id",
          "type": "text",
          "optional": false,
          "description": "Stable id"
        },
        {
          "id": "f_text",
          "name": "text",
          "type": "text",
          "optional": false,
          "description": "Verbatim feedback"
        }
      ]
    },
    {
      "id": "m_route",
      "name": "RoutedFeedback",
      "description": "Classified feedback with bucket and quote.",
      "fields": [
        {
          "id": "f_id",
          "name": "feedback_id",
          "type": "text",
          "optional": false,
          "description": "Matches input id"
        },
        {
          "id": "f_bucket",
          "name": "bucket",
          "type": "text",
          "optional": false,
          "description": "eng | design | docs | sales | praise"
        },
        {
          "id": "f_quote",
          "name": "representative_quote",
          "type": "text",
          "optional": false,
          "description": "Short quote"
        }
      ]
    }
  ],
  "modules": [
    {
      "id": "mod_in",
      "kind": "input",
      "label": "Feedback Dump",
      "inputType": "text",
      "inputNameContains": "product_feedback",
      "outStructureId": "m_builtin_document",
      "cached": true,
      "avgMs": 80,
      "avgCostCents": 0,
      "inputDescription": "Raw product feedback dump — bullet list of user comments"
    },
    {
      "id": "mod_split",
      "kind": "custom-code",
      "label": "Split Bullets",
      "inputDescription": "Product feedback Document from the upload step, ready to split into bullet items",
      "inStructureId": "m_builtin_document",
      "outStructureId": "m_item",
      "cached": true,
      "avgMs": 5,
      "avgCostCents": 0,
      "fallbackList": [
        {
          "typescript": "(doc)=>doc.content.split(\"\\n\").filter((l)=>l.trim().startsWith(\"-\")).map((l,i)=>({feedback_id:String(i+1),text:l.replace(/^-\\s*/,\"\").trim()}))"
        }
      ],
      "outType": {
        "kind": "list",
        "item": {
          "kind": "ref",
          "modelId": "m_item"
        }
      }
    },
    {
      "id": "mod_route",
      "kind": "llm-batch",
      "label": "Classify Each Item",
      "inStructureId": "m_item",
      "outStructureId": "m_route",
      "inputDescription": "List of FeedbackItem objects — one bullet of verbatim user feedback",
      "prompt": "Classify product feedback into eng, design, docs, sales, or praise. Include a short representative_quote. Keep feedback_id.",
      "model": "deepseek-v3",
      "cached": true,
      "avgMs": 1800,
      "avgCostCents": 4,
      "outType": {
        "kind": "list",
        "item": {
          "kind": "ref",
          "modelId": "m_route"
        }
      }
    },
    {
      "id": "mod_out",
      "kind": "output",
      "label": "Routed Feedback",
      "inStructureId": "m_route",
      "outStructureId": "m_route",
      "cached": true,
      "avgMs": 40,
      "avgCostCents": 0,
      "inputDescription": "List of RoutedFeedback records — bucket and quote per feedback item",
      "outType": {
        "kind": "list",
        "item": {
          "kind": "ref",
          "modelId": "m_route"
        }
      }
    }
  ],
  "strategies": [
    {
      "id": "s_single_fb",
      "kind": "single-llm",
      "name": "Single LLM Call",
      "enabled": true,
      "model": "deepseek-v3",
      "accuracy": 78,
      "latencyMs": 3200,
      "costCents": 8,
      "passRate": 90
    },
    {
      "id": "s_agent_fb",
      "kind": "claude-code",
      "name": "Agent (Frontier)",
      "enabled": true,
      "model": "deepseek-v3",
      "accuracy": 92,
      "latencyMs": 28000,
      "costCents": 160,
      "passRate": 97
    },
    {
      "id": "s_cheap_fb",
      "kind": "cheap-agent",
      "name": "Agent (Cheap Model)",
      "enabled": true,
      "model": "deepseek-v3",
      "accuracy": 82,
      "latencyMs": 18000,
      "costCents": 12,
      "passRate": 89
    }
  ],
  "docs": [
    {
      "name": "march_product_feedback.txt",
      "type": "text",
      "label": "inference",
      "file": "feedback_router/product_feedback.txt"
    }
  ]
}
