{
  "id": "p_homework_grader",
  "name": "Homework Grader",
  "kind": "education",
  "models": [
    {
      "id": "m_doc",
      "name": "SourceDocument",
      "description": "Raw document annotated with its purpose.",
      "fields": [
        {
          "id": "f_purpose",
          "name": "purpose",
          "type": "text",
          "optional": false,
          "description": "What this document contains"
        },
        {
          "id": "f_body",
          "name": "body",
          "type": "text",
          "optional": false,
          "description": "Full extracted text"
        }
      ]
    },
    {
      "id": "m_sub_set",
      "name": "HomeworkSubmissionSet",
      "description": "One or more student homework sheets for the same assignment.",
      "fields": [
        {
          "id": "f_subs",
          "name": "submissions",
          "type": "list[model]",
          "optional": false,
          "minItems": 1,
          "description": "Student work to grade",
          "ref": "m_doc"
        }
      ]
    },
    {
      "id": "m_rubric_q",
      "name": "RubricQuestion",
      "description": "One question in the marking schema.",
      "fields": [
        {
          "id": "f_qid",
          "name": "question_id",
          "type": "text",
          "optional": false,
          "description": "Stable question id"
        },
        {
          "id": "f_prompt",
          "name": "prompt",
          "type": "text",
          "optional": false,
          "description": "Question text"
        },
        {
          "id": "f_max",
          "name": "max_score",
          "type": "int",
          "optional": false,
          "description": "Points possible"
        },
        {
          "id": "f_criteria",
          "name": "marking_criteria",
          "type": "text",
          "optional": false,
          "description": "How to award marks"
        }
      ]
    },
    {
      "id": "m_rubric_sec",
      "name": "RubricSection",
      "description": "One section in the derived marking schema.",
      "fields": [
        {
          "id": "f_sid",
          "name": "section_id",
          "type": "text",
          "optional": false,
          "description": "Section id"
        },
        {
          "id": "f_title",
          "name": "title",
          "type": "text",
          "optional": false,
          "description": "Section title"
        },
        {
          "id": "f_max",
          "name": "max_score",
          "type": "int",
          "optional": false,
          "description": "Points possible for the section"
        },
        {
          "id": "f_criteria",
          "name": "criteria",
          "type": "text",
          "optional": false,
          "description": "Section-level marking notes"
        },
        {
          "id": "f_questions",
          "name": "questions",
          "type": "list[model]",
          "optional": false,
          "description": "Questions in this section",
          "ref": "m_rubric_q"
        }
      ]
    },
    {
      "id": "m_schema",
      "name": "MarkingSchema",
      "description": "Dynamic rubric inferred from the unmarked template.",
      "fields": [
        {
          "id": "f_title",
          "name": "assignment_title",
          "type": "text",
          "optional": false,
          "description": "Homework title"
        },
        {
          "id": "f_sections",
          "name": "sections",
          "type": "list[model]",
          "optional": false,
          "description": "Sections to grade",
          "ref": "m_rubric_sec"
        }
      ]
    },
    {
      "id": "m_work",
      "name": "GraderWork",
      "description": "Marking schema plus all student submissions.",
      "fields": [
        {
          "id": "f_schema",
          "name": "marking_schema",
          "type": "model",
          "optional": false,
          "description": "Derived rubric",
          "ref": "m_schema"
        },
        {
          "id": "f_subs",
          "name": "student_submissions",
          "type": "list[model]",
          "optional": false,
          "minItems": 1,
          "description": "Student homework sheets",
          "ref": "m_doc"
        }
      ]
    },
    {
      "id": "m_gradable",
      "name": "GradableSection",
      "description": "One student section ready for batch grading.",
      "fields": [
        {
          "id": "f_student",
          "name": "student_label",
          "type": "text",
          "optional": false,
          "description": "Student name or id"
        },
        {
          "id": "f_sid",
          "name": "section_id",
          "type": "text",
          "optional": false,
          "description": "Matches rubric section id"
        },
        {
          "id": "f_title",
          "name": "title",
          "type": "text",
          "optional": false,
          "description": "Section title"
        },
        {
          "id": "f_body",
          "name": "body",
          "type": "text",
          "optional": false,
          "description": "Questions and student work"
        },
        {
          "id": "f_max",
          "name": "max_score",
          "type": "int",
          "optional": false,
          "description": "Points possible"
        },
        {
          "id": "f_criteria",
          "name": "criteria",
          "type": "text",
          "optional": false,
          "description": "Marking criteria for this section"
        }
      ]
    },
    {
      "id": "m_grade",
      "name": "SectionGrade",
      "description": "Marks for one homework section.",
      "fields": [
        {
          "id": "f_student",
          "name": "student_label",
          "type": "text",
          "optional": false,
          "description": "Student graded"
        },
        {
          "id": "f_sid",
          "name": "section_id",
          "type": "text",
          "optional": false,
          "description": "Matches section id"
        },
        {
          "id": "f_score",
          "name": "score",
          "type": "int",
          "optional": false,
          "description": "Points awarded"
        },
        {
          "id": "f_max",
          "name": "max_score",
          "type": "int",
          "optional": false,
          "description": "Points possible"
        },
        {
          "id": "f_feedback",
          "name": "feedback",
          "type": "text",
          "optional": false,
          "description": "Marking comments"
        }
      ]
    }
  ],
  "modules": [
    {
      "id": "mod_in_template",
      "kind": "input",
      "label": "Marking Template",
      "note": "Unmarked homework — questions + teacher marking scheme only.",
      "inputType": "text",
      "inputNameContains": "homework_template",
      "outStructureId": "m_doc",
      "cached": true,
      "avgMs": 90,
      "avgCostCents": 0
    },
    {
      "id": "mod_schema",
      "kind": "llm",
      "label": "Derive Marking Schema",
      "note": "Build a structured rubric from the unmarked template.",
      "inStructureId": "m_doc",
      "outStructureId": "m_schema",
      "prompt": "The input is an unmarked homework template (body field). Infer assignment_title and sections from markdown ## headings. For each section include section_id, title, max_score (from heading pts if present), criteria (from the teacher marking scheme), and questions with question_id, prompt, max_score, marking_criteria.",
      "model": "deepseek-v3",
      "cached": true,
      "avgMs": 2800,
      "avgCostCents": 7
    },
    {
      "id": "mod_in_subs",
      "kind": "input",
      "label": "Student Submissions",
      "note": "Any number of completed homework sheets with the same structure.",
      "inputType": "text",
      "inputNameContains": "homework_student",
      "inputMinCount": 1,
      "outStructureId": "m_doc",
      "outIsList": true,
      "cached": true,
      "avgMs": 90,
      "avgCostCents": 0
    },
    {
      "id": "mod_assemble",
      "kind": "custom-code",
      "label": "Assemble Grader Work",
      "note": "Merge derived schema with all student submissions.",
      "inStructureId": "m_doc",
      "outStructureId": "m_work",
      "cached": true,
      "avgMs": 6,
      "avgCostCents": 0,
      "fallbackList": [
        {
          "typescript": "(subs, state) => ({ marking_schema: state[\"Derive Marking Schema\"], student_submissions: Array.isArray(subs) ? subs : [subs] })"
        }
      ]
    },
    {
      "id": "mod_flatten",
      "kind": "custom-code",
      "label": "Flatten Sections",
      "note": "Split each submission into gradable sections aligned to the rubric.",
      "inStructureId": "m_work",
      "outStructureId": "m_gradable",
      "outIsList": true,
      "cached": true,
      "avgMs": 10,
      "avgCostCents": 0,
      "fallbackList": [
        {
          "typescript": "(work) => { const schema = work.marking_schema; const sections = schema?.sections ?? []; const out = []; for (const sub of work.student_submissions ?? []) { const body = sub.body ?? \"\"; const student = (body.match(/Student:\\\\s*(.+)/i) || [])[1]?.trim() ?? sub.purpose ?? \"student\"; const chunks = body.split(/\\\\n## /).filter((c) => c.trim()); chunks.forEach((chunk, i) => { const lines = chunk.split(\"\\\\n\"); const title = lines[0].replace(/^#+\\\\s*/, \"\").trim(); const rubric = sections.find((s) => s.title === title) ?? sections[i]; out.push({ student_label: student, section_id: rubric?.section_id ?? String(i + 1), title, body: lines.slice(1).join(\"\\\\n\").trim(), max_score: rubric?.max_score ?? 10, criteria: rubric?.criteria ?? \"\" }); }); } return out; }"
        }
      ]
    },
    {
      "id": "mod_grade",
      "kind": "llm-batch",
      "label": "Grade Each Section",
      "inStructureId": "m_gradable",
      "outStructureId": "m_grade",
      "outIsList": true,
      "prompt": "Grade this student's homework section using max_score and criteria. Award partial credit for correct method. Return student_label and section_id matching the input.",
      "model": "deepseek-v3",
      "cached": true,
      "avgMs": 2400,
      "avgCostCents": 6
    },
    {
      "id": "mod_out",
      "kind": "output",
      "label": "Grades",
      "inStructureId": "m_grade",
      "outStructureId": "m_grade",
      "outIsList": true,
      "cached": true,
      "avgMs": 40,
      "avgCostCents": 0
    }
  ],
  "strategies": [
    {
      "id": "s_single_hw",
      "kind": "single-llm",
      "name": "Single LLM Call",
      "enabled": true,
      "model": "deepseek-v3",
      "accuracy": 78,
      "latencyMs": 3200,
      "costCents": 8,
      "passRate": 90
    },
    {
      "id": "s_rlm_hw",
      "kind": "rlm",
      "name": "Recursive LM",
      "enabled": true,
      "model": "deepseek-v3",
      "accuracy": 86,
      "latencyMs": 9800,
      "costCents": 21,
      "passRate": 94
    },
    {
      "id": "s_agent_hw",
      "kind": "claude-code",
      "name": "Agent (Frontier)",
      "enabled": true,
      "model": "deepseek-v3",
      "accuracy": 92,
      "latencyMs": 28000,
      "costCents": 160,
      "passRate": 97
    },
    {
      "id": "s_cheap_hw",
      "kind": "cheap-agent",
      "name": "Agent (Cheap Model)",
      "enabled": true,
      "model": "deepseek-v3",
      "accuracy": 82,
      "latencyMs": 18000,
      "costCents": 12,
      "passRate": 89
    }
  ],
  "docs": [
    {
      "name": "homework_template_unmarked.md",
      "type": "text",
      "label": "inference",
      "file": "homework_grader/homework_template_unmarked.md"
    },
    {
      "name": "homework_student_sam.md",
      "type": "text",
      "label": "inference",
      "file": "homework_grader/homework_student_sam.md"
    },
    {
      "name": "homework_student_jordan.md",
      "type": "text",
      "label": "inference",
      "file": "homework_grader/homework_student_jordan.md"
    },
    {
      "name": "homework_student_alex.md",
      "type": "text",
      "label": "inference",
      "file": "homework_grader/homework_student_alex.md"
    }
  ]
}
