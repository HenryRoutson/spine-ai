{
  "id": "p_homework_grader",
  "name": "Homework Grader",
  "kind": "education",
  "models": [
    {
      "id": "m_rubric_q",
      "name": "RubricQuestion",
      "description": "One question in the marking schema.",
      "fields": [
        {
          "id": "f_qid",
          "name": "question_id",
          "type": "text",
          "optional": false,
          "description": "Stable question id"
        },
        {
          "id": "f_prompt",
          "name": "prompt",
          "type": "text",
          "optional": false,
          "description": "Question text"
        },
        {
          "id": "f_max",
          "name": "max_score",
          "type": "int",
          "optional": false,
          "description": "Points possible"
        },
        {
          "id": "f_criteria",
          "name": "marking_criteria",
          "type": "text",
          "optional": false,
          "description": "How to award marks"
        }
      ]
    },
    {
      "id": "m_rubric_sec",
      "name": "RubricSection",
      "description": "One section in the derived marking schema.",
      "fields": [
        {
          "id": "f_sid",
          "name": "section_id",
          "type": "text",
          "optional": false,
          "description": "Section id"
        },
        {
          "id": "f_title",
          "name": "title",
          "type": "text",
          "optional": false,
          "description": "Section title"
        },
        {
          "id": "f_max",
          "name": "max_score",
          "type": "int",
          "optional": false,
          "description": "Points possible for the section"
        },
        {
          "id": "f_criteria",
          "name": "criteria",
          "type": "text",
          "optional": false,
          "description": "Section-level marking notes"
        },
        {
          "id": "f_questions",
          "name": "questions",
          "type": "list[model]",
          "optional": false,
          "description": "Questions in this section",
          "ref": "m_rubric_q"
        }
      ]
    },
    {
      "id": "m_schema",
      "name": "MarkingSchema",
      "description": "Structured rubric — assignment sections and questions to grade against.",
      "dynamic": true,
      "fields": [
        {
          "id": "f_title",
          "name": "assignment_title",
          "type": "text",
          "optional": false,
          "description": "Homework title"
        },
        {
          "id": "f_sections",
          "name": "sections",
          "type": "list[model]",
          "optional": false,
          "description": "Sections to grade",
          "ref": "m_rubric_sec"
        }
      ]
    },
    {
      "id": "m_hw_combined",
      "name": "HomeworkGraderInput",
      "description": "Auto-generated by the Combine Inputs step.",
      "auto": true,
      "fields": [
        {
          "id": "f_student_doc",
          "name": "student_submission",
          "type": "document",
          "optional": false,
          "description": "Student submission attached at combine"
        },
        {
          "id": "f_questions",
          "name": "marking_questions",
          "type": "list[model]",
          "optional": false,
          "description": "Flat rubric questions from the template",
          "ref": "m_rubric_q"
        }
      ]
    },
    {
      "id": "m_work",
      "name": "GraderWork",
      "description": "Marking schema document plus student submission documents.",
      "fields": [
        {
          "id": "f_schema",
          "name": "marking_schema",
          "type": "document",
          "optional": false,
          "description": "Derived rubric (JSON in content)"
        },
        {
          "id": "f_subs",
          "name": "student_submissions",
          "type": "list[document]",
          "optional": false,
          "description": "Student homework sheets",
          "minItems": 1
        }
      ]
    },
    {
      "id": "m_gradable",
      "name": "GradableSection",
      "description": "One student × question row ready for batch grading.",
      "fields": [
        {
          "id": "f_student",
          "name": "student_label",
          "type": "text",
          "optional": false,
          "description": "Student name or id"
        },
        {
          "id": "f_sid",
          "name": "section_id",
          "type": "text",
          "optional": false,
          "description": "Matches rubric section id"
        },
        {
          "id": "f_title",
          "name": "title",
          "type": "text",
          "optional": false,
          "description": "Section and question title"
        },
        {
          "id": "f_body",
          "name": "body",
          "type": "text",
          "optional": false,
          "description": "Question prompt and student work"
        },
        {
          "id": "f_max",
          "name": "max_score",
          "type": "int",
          "optional": false,
          "description": "Points possible"
        },
        {
          "id": "f_criteria",
          "name": "criteria",
          "type": "text",
          "optional": false,
          "description": "Marking criteria for this question"
        }
      ]
    },
    {
      "id": "m_grade",
      "name": "SectionGrade",
      "description": "Marks for one homework question.",
      "fields": [
        {
          "id": "f_student",
          "name": "student_label",
          "type": "text",
          "optional": false,
          "description": "Student graded"
        },
        {
          "id": "f_sid",
          "name": "section_id",
          "type": "text",
          "optional": false,
          "description": "Matches section id"
        },
        {
          "id": "f_score",
          "name": "score",
          "type": "int",
          "optional": false,
          "description": "Points awarded"
        },
        {
          "id": "f_max",
          "name": "max_score",
          "type": "int",
          "optional": false,
          "description": "Points possible"
        },
        {
          "id": "f_feedback",
          "name": "feedback",
          "type": "text",
          "optional": false,
          "description": "Marking comments",
          "deterministic": false
        }
      ]
    }
  ],
  "modules": [
    {
      "id": "mod_in_schema",
      "kind": "input",
      "label": "Marking Schema",
      "note": "Structured rubric JSON — sections and questions to grade against.",
      "inputType": "json",
      "inputNameContains": "marking_schema",
      "outStructureId": "m_schema",
      "cached": true,
      "avgMs": 90,
      "avgCostCents": 0,
      "inputDescription": "MarkingSchema JSON — assignment_title and sections with nested RubricQuestion lists"
    },
    {
      "id": "mod_questions",
      "kind": "custom-code",
      "label": "Marking Questions List",
      "note": "Flatten rubric questions — one list item per gradable question.",
      "inputDescription": "MarkingSchema object — sections with nested RubricQuestion lists",
      "inStructureId": "m_schema",
      "outStructureId": "m_rubric_q",
      "outIsList": true,
      "cached": true,
      "avgMs": 3,
      "avgCostCents": 0,
      "fallbackList": [
        {
          "typescript": "(schema) => (schema.sections ?? []).flatMap((s) => s.questions ?? [])"
        }
      ]
    },
    {
      "id": "mod_in_students",
      "kind": "input",
      "label": "Student Submissions",
      "note": "One or more completed student homework sheets to grade.",
      "inputType": "text",
      "inputNameContains": "homework_student",
      "inputMinCount": 1,
      "outStructureId": "m_builtin_document",
      "outIsList": true,
      "cached": true,
      "avgMs": 90,
      "avgCostCents": 0,
      "inputDescription": "One student's completed homework sheet — markdown with question prompts and student work answers"
    },
    {
      "id": "mod_combine",
      "kind": "combine",
      "label": "Combine Inputs",
      "note": "Merges flat marking questions with each student submission document.",
      "inputDescription": "One student homework Document (new input) plus flat RubricQuestion list from Marking Questions List (pipeline state)",
      "inStructureId": "m_rubric_q",
      "outStructureId": "m_hw_combined",
      "cached": true,
      "avgMs": 40,
      "avgCostCents": 0
    },
    {
      "id": "mod_assemble",
      "kind": "custom-code",
      "label": "Assemble Grader Work",
      "note": "Merge derived schema with all student submissions from pipeline state.",
      "inputDescription": "HomeworkGraderInput from combine — schema JSON plus student submission documents in pipeline state",
      "inStructureId": "m_hw_combined",
      "outStructureId": "m_work",
      "cached": true,
      "avgMs": 6,
      "avgCostCents": 0,
      "fallbackList": [
        {
          "typescript": "(_combined, state) => { const schema = state[\"Marking Schema\"]; const subs = state[\"Student Submissions\"]; const list = Array.isArray(subs) ? subs : subs ? [subs] : []; const text = (s) => (typeof s?.content === \"string\" ? s.content : typeof s?.body === \"string\" ? s.body : \"\"); const name = (s, i) => (typeof s?.filename === \"string\" && s.filename ? s.filename : typeof s?.doc_id === \"string\" ? s.doc_id : `student_${i + 1}.md`); const sortKeys = (v) => (Array.isArray(v) ? v.map(sortKeys) : v && typeof v === \"object\" ? Object.fromEntries(Object.keys(v).sort().map((k) => [k, sortKeys(v[k])])) : v); return { marking_schema: { filename: \"marking_schema.json\", content: JSON.stringify(sortKeys(schema ?? {})) }, student_submissions: list.map((s, i) => ({ filename: name(s, i), content: text(s) })) }; }"
        }
      ]
    },
    {
      "id": "mod_flatten",
      "kind": "custom-code",
      "label": "Flatten Sections",
      "note": "One gradable row per student × rubric question.",
      "inputDescription": "GraderWork — marking_schema Document plus list of student submission Documents",
      "inStructureId": "m_work",
      "outStructureId": "m_gradable",
      "outIsList": true,
      "cached": true,
      "avgMs": 10,
      "avgCostCents": 0,
      "fallbackList": [
        {
          "typescript": "(work) => { let sections = []; const ms = work.marking_schema; if (ms?.sections) sections = ms.sections; else if (typeof ms?.content === \"string\") { try { sections = JSON.parse(ms.content).sections ?? []; } catch {} } const out = []; for (const sub of work.student_submissions ?? []) { const content = sub.content ?? \"\"; const student = (content.match(/Student:\\s*([^\\n]+)/i) || [])[1]?.trim() || sub.filename?.replace(/\\.md$/i, \"\") || \"student\"; for (const sec of sections) { for (const q of sec.questions ?? []) { const qRe = new RegExp(`\\\\*\\\\*${q.question_id}\\\\.\\\\*\\\\*[\\\\s\\\\S]*?(Student work:[^\\\\n]*)`, \"i\"); const workLine = (content.match(qRe) || [])[1]?.trim() ?? \"\"; out.push({ student_label: student, section_id: sec.section_id, title: `${sec.title} — ${q.question_id}`, body: `${q.prompt ?? \"\"}${workLine ? \"\\n\" + workLine : \"\"}`, max_score: q.max_score ?? 1, criteria: q.marking_criteria ?? sec.criteria ?? \"\" }); } } } return out; }"
        }
      ]
    },
    {
      "id": "mod_grade",
      "kind": "llm-batch",
      "label": "Grade Each Section",
      "inStructureId": "m_gradable",
      "outStructureId": "m_grade",
      "outIsList": true,
      "inputDescription": "List of GradableSection objects — student_label, question body, max_score, and criteria",
      "prompt": "Grade this student's homework section using max_score and criteria. Award partial credit for correct method. Return student_label and section_id exactly matching the input (do not change them).",
      "model": "deepseek-v3",
      "cached": true,
      "avgMs": 2400,
      "avgCostCents": 6,
      "note": "List of GradableSection objects — student_label, question body, max_score, and criteria"
    },
    {
      "id": "mod_out",
      "kind": "output",
      "label": "Final Output",
      "inStructureId": "m_grade",
      "outStructureId": "m_grade",
      "outIsList": true,
      "cached": true,
      "avgMs": 40,
      "avgCostCents": 0,
      "inputDescription": "List of SectionGrade rows — student_label, section_id, score, max_score, feedback (one row per student × rubric question)",
      "note": ""
    },
    {
      "id": "mod_assert",
      "kind": "assert",
      "label": "Grade Count Check",
      "note": "len(Student Submissions) × len(Marking Questions List) = len(Final Output)",
      "inStructureId": "m_grade",
      "outStructureId": "m_grade",
      "outIsList": true,
      "inputDescription": "List of SectionGrade rows — student_label, section_id, score, max_score, feedback (one row per student × rubric question)",
      "cached": true,
      "avgMs": 2,
      "avgCostCents": 0,
      "fallbackList": [
        {
          "typescript": "const nStudents = len(step(\"Student Submissions\"));\nconst nQuestions = len(step(\"Marking Questions List\"));\nconst nOut = len(step(\"Final Output\"));\nif (nStudents * nQuestions !== nOut) {\n  throw new Error(`expected ${nStudents}×${nQuestions}=${nStudents * nQuestions} grades, got ${nOut}`);\n}"
        },
        {
          "python": "n_students = len_of(step('Student Submissions'))\nn_questions = len_of(step('Marking Questions List'))\nn_out = len_of(step('Final Output'))\nif n_students * n_questions != n_out:\n    raise ValueError(f'expected {n_students}×{n_questions}={n_students * n_questions} grades, got {n_out}')"
        }
      ]
    }
  ],
  "strategies": [
    {
      "id": "s_single_hw",
      "kind": "single-llm",
      "name": "Single LLM Call",
      "enabled": true,
      "model": "deepseek-v3",
      "accuracy": 78,
      "latencyMs": 3200,
      "costCents": 8,
      "passRate": 90
    },
    {
      "id": "s_agent_hw",
      "kind": "claude-code",
      "name": "Agent (Frontier)",
      "enabled": true,
      "model": "deepseek-v3",
      "accuracy": 92,
      "latencyMs": 28000,
      "costCents": 160,
      "passRate": 97
    },
    {
      "id": "s_cheap_hw",
      "kind": "cheap-agent",
      "name": "Agent (Cheap Model)",
      "enabled": true,
      "model": "deepseek-v3",
      "accuracy": 82,
      "latencyMs": 18000,
      "costCents": 12,
      "passRate": 89
    }
  ],
