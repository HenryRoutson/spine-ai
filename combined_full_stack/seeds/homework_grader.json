{
  "id": "p_homework_grader",
  "name": "Homework Grader",
  "kind": "education",
  "models": [
    {
      "id": "m_doc",
      "name": "SourceDocument",
      "description": "Raw document annotated with its purpose.",
      "fields": [
        {
          "id": "f_purpose",
          "name": "purpose",
          "type": "text",
          "optional": false,
          "description": "What this document contains"
        },
        {
          "id": "f_body",
          "name": "body",
          "type": "text",
          "optional": false,
          "description": "Full extracted text"
        }
      ]
    },
    {
      "id": "m_hw_inputs",
      "name": "HomeworkInputs",
      "description": "Marking template plus student submissions split from one document batch.",
      "fields": [
        {
          "id": "f_template",
          "name": "template",
          "type": "model",
          "optional": false,
          "description": "Unmarked homework template",
          "ref": "m_doc"
        },
        {
          "id": "f_subs",
          "name": "submissions",
          "type": "list[model]",
          "optional": false,
          "minItems": 1,
          "description": "Student work to grade",
          "ref": "m_doc"
        }
      ]
    },
    {
      "id": "m_rubric_q",
      "name": "RubricQuestion",
      "description": "One question in the marking schema.",
      "fields": [
        {
          "id": "f_qid",
          "name": "question_id",
          "type": "text",
          "optional": false,
          "description": "Stable question id"
        },
        {
          "id": "f_prompt",
          "name": "prompt",
          "type": "text",
          "optional": false,
          "description": "Question text"
        },
        {
          "id": "f_max",
          "name": "max_score",
          "type": "int",
          "optional": false,
          "description": "Points possible"
        },
        {
          "id": "f_criteria",
          "name": "marking_criteria",
          "type": "text",
          "optional": false,
          "description": "How to award marks"
        }
      ]
    },
    {
      "id": "m_rubric_sec",
      "name": "RubricSection",
      "description": "One section in the derived marking schema.",
      "fields": [
        {
          "id": "f_sid",
          "name": "section_id",
          "type": "text",
          "optional": false,
          "description": "Section id"
        },
        {
          "id": "f_title",
          "name": "title",
          "type": "text",
          "optional": false,
          "description": "Section title"
        },
        {
          "id": "f_max",
          "name": "max_score",
          "type": "int",
          "optional": false,
          "description": "Points possible for the section"
        },
        {
          "id": "f_criteria",
          "name": "criteria",
          "type": "text",
          "optional": false,
          "description": "Section-level marking notes"
        },
        {
          "id": "f_questions",
          "name": "questions",
          "type": "list[model]",
          "optional": false,
          "description": "Questions in this section",
          "ref": "m_rubric_q"
        }
      ]
    },
    {
      "id": "m_schema",
      "name": "MarkingSchema",
      "description": "Dynamic rubric inferred from the unmarked template.",
      "fields": [
        {
          "id": "f_title",
          "name": "assignment_title",
          "type": "text",
          "optional": false,
          "description": "Homework title"
        },
        {
          "id": "f_sections",
          "name": "sections",
          "type": "list[model]",
          "optional": false,
          "description": "Sections to grade",
          "ref": "m_rubric_sec"
        }
      ]
    },
    {
      "id": "m_hw_combined",
      "name": "HomeworkGraderInput",
      "description": "Auto-generated by the Combine Inputs step.",
      "auto": true,
      "fields": [
        {
          "id": "f_student_doc",
          "name": "student_submission",
          "type": "document",
          "optional": false,
          "description": "Student submission attached at combine (full set in pipeline state)"
        },
        {
          "id": "f_questions",
          "name": "marking_questions",
          "type": "list[model]",
          "optional": false,
          "description": "Flat rubric questions from the template",
          "ref": "m_rubric_q"
        }
      ]
    },
    {
      "id": "m_work",
      "name": "GraderWork",
      "description": "Marking schema document plus student submission documents.",
      "fields": [
        {
          "id": "f_schema",
          "name": "marking_schema",
          "type": "document",
          "optional": false,
          "description": "Derived rubric (JSON in body)"
        },
        {
          "id": "f_subs",
          "name": "student_submissions",
          "type": "list[document]",
          "optional": false,
          "minItems": 1,
          "description": "Student homework sheets"
        }
      ]
    },
    {
      "id": "m_gradable",
      "name": "GradableSection",
      "description": "One student section ready for batch grading.",
      "fields": [
        {
          "id": "f_student",
          "name": "student_label",
          "type": "text",
          "optional": false,
          "description": "Student name or id"
        },
        {
          "id": "f_sid",
          "name": "section_id",
          "type": "text",
          "optional": false,
          "description": "Matches rubric section id"
        },
        {
          "id": "f_title",
          "name": "title",
          "type": "text",
          "optional": false,
          "description": "Section title"
        },
        {
          "id": "f_body",
          "name": "body",
          "type": "text",
          "optional": false,
          "description": "Questions and student work"
        },
        {
          "id": "f_max",
          "name": "max_score",
          "type": "int",
          "optional": false,
          "description": "Points possible"
        },
        {
          "id": "f_criteria",
          "name": "criteria",
          "type": "text",
          "optional": false,
          "description": "Marking criteria for this section"
        }
      ]
    },
    {
      "id": "m_grade",
      "name": "SectionGrade",
      "description": "Marks for one homework section.",
      "fields": [
        {
          "id": "f_student",
          "name": "student_label",
          "type": "text",
          "optional": false,
          "description": "Student graded"
        },
        {
          "id": "f_sid",
          "name": "section_id",
          "type": "text",
          "optional": false,
          "description": "Matches section id"
        },
        {
          "id": "f_score",
          "name": "score",
          "type": "int",
          "optional": false,
          "description": "Points awarded"
        },
        {
          "id": "f_max",
          "name": "max_score",
          "type": "int",
          "optional": false,
          "description": "Points possible"
        },
        {
          "id": "f_feedback",
          "name": "feedback",
          "type": "text",
          "optional": false,
          "description": "Marking comments"
        }
      ]
    }
  ],
  "modules": [
    {
      "id": "mod_in_template",
      "kind": "input",
      "label": "Unmarked Template",
      "note": "Teacher marking schema source — unmarked homework sheet.",
      "inputType": "text",
      "inputNameContains": "template_unmarked",
      "outStructureId": "m_doc",
      "cached": true,
      "avgMs": 90,
      "avgCostCents": 0
    },
    {
      "id": "mod_schema",
      "kind": "llm",
      "label": "Derive Marking Schema",
      "note": "Build a structured rubric from the unmarked template.",
      "inStructureId": "m_doc",
      "outStructureId": "m_schema",
      "prompt": "The input is an unmarked homework template (body field). Infer assignment_title and sections from markdown ## headings. For each section include section_id, title, max_score (from heading pts if present), criteria (from the teacher marking scheme), and questions with question_id, prompt, max_score, marking_criteria.",
      "model": "deepseek-v3",
      "cached": true,
      "avgMs": 2800,
      "avgCostCents": 7
    },
    {
      "id": "mod_questions",
      "kind": "custom-code",
      "label": "Marking Questions List",
      "note": "Flatten rubric questions — one list item per gradable question.",
      "inStructureId": "m_schema",
      "outStructureId": "m_rubric_q",
      "outIsList": true,
      "cached": true,
      "avgMs": 3,
      "avgCostCents": 0,
      "fallbackList": [
        {
          "typescript": "(schema) => (schema.sections ?? []).flatMap((s) => s.questions ?? [])"
        }
      ]
    },
    {
      "id": "mod_in_students",
      "kind": "input",
      "label": "Student Submissions",
      "note": "One or more completed student homework sheets to grade.",
      "inputType": "text",
      "inputNameContains": "homework_student",
      "inputMinCount": 1,
      "outStructureId": "m_doc",
      "outIsList": true,
      "cached": true,
      "avgMs": 90,
      "avgCostCents": 0
    },
    {
      "id": "mod_combine",
      "kind": "combine",
      "label": "Combine Inputs",
      "note": "Merges flat marking questions with student submission documents.",
      "inStructureId": "m_rubric_q",
      "outStructureId": "m_hw_combined",
      "cached": true,
      "avgMs": 40,
      "avgCostCents": 0
    },
    {
      "id": "mod_assemble",
      "kind": "custom-code",
      "label": "Assemble Grader Work",
      "note": "Merge derived schema with all student submissions from pipeline state.",
      "inStructureId": "m_hw_combined",
      "outStructureId": "m_work",
      "cached": true,
      "avgMs": 6,
      "avgCostCents": 0,
      "fallbackList": [
        {
          "typescript": "(_combined, state) => { const schema = state[\"Derive Marking Schema\"]; const subs = state[\"Student Submissions\"]; const list = Array.isArray(subs) ? subs : subs ? [subs] : []; return { marking_schema: { doc_id: \"marking_schema\", purpose: \"derived rubric\", body: JSON.stringify(schema) }, student_submissions: list.map((s) => ({ doc_id: s.doc_id ?? \"\", purpose: s.purpose ?? \"student\", body: s.body ?? \"\" })) }; }"
        }
      ]
    },
    {
      "id": "mod_flatten",
      "kind": "custom-code",
      "label": "Flatten Sections",
      "note": "One gradable row per student × rubric question.",
      "inStructureId": "m_work",
      "outStructureId": "m_gradable",
      "outIsList": true,
      "cached": true,
      "avgMs": 10,
      "avgCostCents": 0,
      "fallbackList": [
        {
          "typescript": "(work) => { let sections = []; const ms = work.marking_schema; if (ms?.sections) sections = ms.sections; else if (typeof ms?.body === \"string\") { try { sections = JSON.parse(ms.body).sections ?? []; } catch {} } const out = []; for (const sub of work.student_submissions ?? []) { const body = sub.body ?? \"\"; const student = (body.match(/Student:\\s*([^\\n]+)/i) || [])[1]?.trim() || sub.purpose?.replace(/\\.md$/i, \"\") || \"student\"; for (const sec of sections) { for (const q of sec.questions ?? []) { out.push({ student_label: student, section_id: sec.section_id, title: `${sec.title} — ${q.question_id}`, body: q.prompt ?? \"\", max_score: q.max_score ?? 1, criteria: q.marking_criteria ?? sec.criteria ?? \"\" }); } } } return out; }"
        }
      ]
    },
    {
      "id": "mod_grade",
      "kind": "llm-batch",
      "label": "Grade Each Section",
      "inStructureId": "m_gradable",
      "outStructureId": "m_grade",
      "outIsList": true,
      "prompt": "Grade this student's homework section using max_score and criteria. Award partial credit for correct method. Return student_label and section_id exactly matching the input (do not change them).",
      "model": "deepseek-v3",
      "cached": true,
      "avgMs": 2400,
      "avgCostCents": 6
    },
    {
      "id": "mod_out",
      "kind": "output",
      "label": "Final Output",
      "inStructureId": "m_grade",
      "outStructureId": "m_grade",
      "outIsList": true,
      "cached": true,
      "avgMs": 40,
      "avgCostCents": 0
    },
    {
      "id": "mod_assert",
      "kind": "assert",
      "label": "Grade Count Check",
      "note": "len(Student Submissions) × len(Marking Questions List) = len(Final Output)",
      "inStructureId": "m_grade",
      "outStructureId": "m_grade",
      "outIsList": true,
      "cached": true,
      "avgMs": 2,
      "avgCostCents": 0,
      "fallbackList": [
        {
          "typescript": "const nStudents = len(step(\"Student Submissions\"));\nconst nQuestions = len(step(\"Marking Questions List\"));\nconst nOut = len(step(\"Final Output\"));\nif (nStudents * nQuestions !== nOut) {\n  throw new Error(`expected ${nStudents}×${nQuestions}=${nStudents * nQuestions} grades, got ${nOut}`);\n}"
        },
        {
          "python": "n_students = len_of(step('Student Submissions'))\nn_questions = len_of(step('Marking Questions List'))\nn_out = len_of(step('Final Output'))\nif n_students * n_questions != n_out:\n    raise ValueError(f'expected {n_students}×{n_questions}={n_students * n_questions} grades, got {n_out}')"
        }
      ]
    }
  ],
  "strategies": [
    {
      "id": "s_single_hw",
      "kind": "single-llm",
      "name": "Single LLM Call",
      "enabled": true,
      "model": "deepseek-v3",
      "accuracy": 78,
      "latencyMs": 3200,
      "costCents": 8,
      "passRate": 90
    },
    {
      "id": "s_rlm_hw",
      "kind": "rlm",
      "name": "Recursive LM",
      "enabled": true,
      "model": "deepseek-v3",
      "accuracy": 86,
      "latencyMs": 9800,
      "costCents": 21,
      "passRate": 94
    },
    {
      "id": "s_agent_hw",
      "kind": "claude-code",
      "name": "Agent (Frontier)",
      "enabled": true,
      "model": "deepseek-v3",
      "accuracy": 92,
      "latencyMs": 28000,
      "costCents": 160,
      "passRate": 97
    },
    {
      "id": "s_cheap_hw",
      "kind": "cheap-agent",
      "name": "Agent (Cheap Model)",
      "enabled": true,
      "model": "deepseek-v3",
      "accuracy": 82,
      "latencyMs": 18000,
      "costCents": 12,
      "passRate": 89
    }
  ],
  "docs": [
    {
      "name": "homework_template_unmarked.md",
      "type": "text",
      "label": "inference",
      "file": "homework_grader/homework_template_unmarked.md"
    },
    {
      "name": "homework_student_sam.md",
      "type": "text",
      "label": "inference",
      "file": "homework_grader/homework_student_sam.md"
    },
    {
      "name": "homework_student_jordan.md",
      "type": "text",
      "label": "inference",
      "file": "homework_grader/homework_student_jordan.md"
    },
    {
      "name": "homework_student_alex.md",
      "type": "text",
      "label": "inference",
      "file": "homework_grader/homework_student_alex.md"
    }
  ]
}
