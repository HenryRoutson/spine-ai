{
  "id": "p_legal",
  "name": "Company Legal Evaluation",
  "kind": "legal-compliance",
  "models": [
    {
      "id": "m_rule",
      "name": "AtomicRule",
      "description": "A single rule plus the verbatim quote it was sourced from.",
      "fields": [
        {
          "id": "f_rule_id",
          "name": "rule_id",
          "type": "text",
          "optional": false,
          "description": "Stable identifier"
        },
        {
          "id": "f_description",
          "name": "description",
          "type": "text",
          "optional": false,
          "description": "Plain-language obligation"
        },
        {
          "id": "f_source",
          "name": "source",
          "type": "json",
          "typeExpr": {
            "kind": "named",
            "name": "text_quote_t"
          },
          "optional": false,
          "description": "Rule text + originating quote"
        },
        {
          "id": "f_severity",
          "name": "severity",
          "type": "int",
          "optional": false,
          "description": "1-5 risk weight"
        }
      ]
    },
    {
      "id": "m_combined",
      "name": "EvaluationInput",
      "description": "Auto-generated by the Combine Inputs step.",
      "auto": true,
      "fields": [
        {
          "id": "f_company_data",
          "name": "company_data",
          "type": "document",
          "optional": false,
          "description": "Company outline / filings"
        },
        {
          "id": "f_reqs",
          "name": "company_legal_requirements",
          "type": "list[model]",
          "optional": false,
          "description": "Extracted rules",
          "ref": "m_rule"
        }
      ]
    },
    {
      "id": "m_report",
      "name": "LegalConsiderations",
      "description": "Final document of legal considerations for the company.",
      "fields": [
        {
          "id": "f_summary",
          "name": "summary",
          "type": "text",
          "optional": false,
          "description": "Executive summary",
          "deterministic": false
        },
        {
          "id": "f_rep_rule_id",
          "name": "rule_id",
          "type": "text",
          "optional": false,
          "description": "Rule assessed"
        },
        {
          "id": "f_compliant",
          "name": "compliant",
          "type": "bool",
          "optional": false,
          "description": "Adherence verdict"
        },
        {
          "id": "f_rationale",
          "name": "rationale",
          "type": "text",
          "optional": false,
          "description": "Reasoning",
          "deterministic": false
        },
        {
          "id": "f_liability",
          "name": "liability_usd",
          "type": "float",
          "optional": true,
          "description": "Estimated exposure"
        }
      ]
    }
  ],
  "modules": [
    {
      "id": "mod_input_legal",
      "kind": "input",
      "label": "Legal Document",
      "note": "Parse the contract and annotate its governing purpose.",
      "inputType": [
        "text",
        "pdf"
      ],
      "inputNameContains": "legal_requirements",
      "inputDescription": "Healthcare data legal requirements contract — text or PDF governing obligations",
      "outStructureId": "m_builtin_document",
      "cached": true,
      "avgMs": 110,
      "avgCostCents": 0
    },
    {
      "id": "mod_extract_rules",
      "kind": "llm",
      "label": "Extract Atomic Rules",
      "note": "Document → list[text_quote_t]",
      "inputDescription": "Parsed legal contract Document with full body text ready for rule extraction",
      "inStructureId": "m_builtin_document",
      "outStructureId": "m_rule",
      "prompt": "Extract the 6 most important atomic, independently verifiable legal rules from the document. For each rule, give a stable rule_id (R-01, R-02, …), a concise plain-language description, the verbatim source quote it came from, and a 1-5 severity. Return at most 6 rules.",
      "model": "deepseek-v4",
      "cached": true,
      "avgMs": 2300,
      "avgCostCents": 6,
      "outType": {
        "kind": "list",
        "item": {
          "kind": "ref",
          "modelId": "m_rule"
        }
      }
    },
    {
      "id": "mod_link_quotes",
      "kind": "quote",
      "label": "Link Quotes",
      "auto": true,
      "note": "Auto · AtomicRule → AtomicRule · links LLM quote strings to source spans.",
      "inputDescription": "List of AtomicRule objects with verbatim source quote strings to link to the contract",
      "inStructureId": "m_rule",
      "outStructureId": "m_rule",
      "cached": true,
      "avgMs": 12,
      "avgCostCents": 0,
      "outType": {
        "kind": "list",
        "item": {
          "kind": "ref",
          "modelId": "m_rule"
        }
      }
    },
    {
      "id": "mod_sort_rules",
      "kind": "custom-code",
      "label": "Sort Rules by Severity",
      "note": "Custom TS function — deterministic glue step, no LLM cost.",
      "inputDescription": "List of AtomicRule objects with severity scores to sort descending",
      "inStructureId": "m_rule",
      "outStructureId": "m_rule",
      "cached": true,
      "avgMs": 5,
      "avgCostCents": 0,
      "fallbackList": [
        {
          "typescript": "(rules) => [...rules].sort((a, b) => b.severity - a.severity)"
        }
      ],
      "outType": {
        "kind": "list",
        "item": {
          "kind": "ref",
          "modelId": "m_rule"
        }
      }
    },
    {
      "id": "mod_input_company",
      "kind": "input",
      "label": "Company Data Input",
      "inputType": [
        "text",
        "word"
      ],
      "inputNameContains": "company_legal_compliance",
      "inputDescription": "Company compliance outline describing operations, data handling, and filings",
      "outStructureId": "m_builtin_document",
      "cached": true,
      "avgMs": 90,
      "avgCostCents": 0,
      "note": "Company compliance outline describing operations, data handling, and filings"
    },
    {
      "id": "mod_combine",
      "kind": "combine",
      "label": "Combine Inputs",
      "note": "Builds {\"company_data\", \"company_legal_requirements\"}",
      "inputDescription": "Sorted list of AtomicRule objects from the legal pipeline, ready to merge with company data",
      "inStructureId": "m_rule",
      "outStructureId": "m_combined",
      "cached": true,
      "avgMs": 40,
      "avgCostCents": 0
    },
    {
      "id": "mod_assess",
      "kind": "llm",
      "label": "Assess Compliance",
      "note": "Evaluate the company against every rule.",
      "inputDescription": "Combined evaluation input — company_data document plus extracted legal rules list",
      "inStructureId": "m_combined",
      "outStructureId": "m_report",
      "prompt": "Given the company data and the extracted legal requirements, produce one concise assessment per rule: a short summary, the rule_id, a compliant verdict, a brief rationale, and the estimated USD liability exposure if non-compliant.",
      "model": "deepseek-v4",
      "cached": true,
      "avgMs": 3100,
      "avgCostCents": 12,
      "outType": {
        "kind": "list",
        "item": {
          "kind": "ref",
          "modelId": "m_report"
        }
      }
    },
    {
      "id": "mod_output",
      "kind": "output",
      "label": "Legal Considerations",
      "inputDescription": "List of LegalConsiderations records — one compliance assessment per extracted rule",
      "inStructureId": "m_report",
      "outStructureId": "m_report",
      "cached": true,
      "avgMs": 40,
      "avgCostCents": 0,
      "note": "",
      "outType": {
        "kind": "list",
        "item": {
          "kind": "ref",
          "modelId": "m_report"
        }
      }
    }
  ],
  "strategies": [
    {
      "id": "s_single",
      "kind": "single-llm",
      "name": "Single LLM Call",
      "enabled": true,
      "model": "deepseek-v4",
      "accuracy": 76,
      "latencyMs": 3200,
      "costCents": 8,
      "passRate": 90
    },
    {
      "id": "s_agent",
      "kind": "claude-code",
      "name": "Agent (Frontier)",
      "enabled": true,
      "model": "deepseek-v4",
      "accuracy": 94,
      "latencyMs": 28400,
      "costCents": 180,
      "passRate": 99
    },
    {
      "id": "s_cheap",
      "kind": "cheap-agent",
      "name": "Agent (Cheap Model)",
      "enabled": true,
      "model": "deepseek-v4",
      "accuracy": 84,
      "latencyMs": 18200,
      "costCents": 14,
      "passRate": 91
    }
  ],
  "docs": [
    {
      "name": "health_data_legal_requirements.pdf",
      "type": "text",
      "label": "inference",
      "file": "legal/legal_doc_text.txt"
    },
    {
      "name": "mediflow_company_legal_compliance.md",
      "type": "text",
      "label": "inference",
      "file": "legal/company_for_assessment.md"
    },
    {
      "name": "company_legal_evaluation_testing.json",
      "type": "json",
      "label": "training",
      "file": "legal/company_legal_evaluation_testing.json"
    }
  ],
  "hostedSite": {
    "brand": {
      "companyName": "CounselDesk",
      "tagline": "Atomic rules. Cited compliance.",
      "primaryColor": "#1b2a4a",
      "accentColor": "#b08d57",
      "backgroundColor": "#f4efe6",
      "textColor": "#1a1714"
    },
    "kicker": "Company legal evaluation",
    "lede": "Upload the statute pack and the company record. CounselDesk breaks obligations into atomic rules and scores each one.",
    "cta": "Run evaluation",
    "features": [
      { "kicker": "01", "title": "Atomic rules", "body": "The requirements document is split into single obligations before any scoring call." },
      { "kicker": "02", "title": "Cited evidence", "body": "Each finding points back to the company filing so counsel can verify, not re-read." },
      { "kicker": "03", "title": "Same pipeline", "body": "This page is a skin. The typed DAG underneath is Company Legal Evaluation." }
    ]
  }
}
