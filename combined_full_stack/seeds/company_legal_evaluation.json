{
  "id": "p_legal",
  "name": "Company Legal Evaluation",
  "kind": "legal-compliance",
  "models": [
    {
      "id": "m_doc",
      "name": "SourceDocument",
      "description": "Raw legal document annotated with its purpose.",
      "fields": [
        { "id": "f_purpose", "name": "purpose", "type": "text", "optional": false, "description": "What this document governs" },
        { "id": "f_body", "name": "body", "type": "text", "optional": false, "description": "Full extracted text" }
      ]
    },
    {
      "id": "m_rule",
      "name": "AtomicRule",
      "description": "A single rule plus the verbatim quote it was sourced from.",
      "fields": [
        { "id": "f_rule_id", "name": "rule_id", "type": "text", "optional": false, "description": "Stable identifier" },
        { "id": "f_description", "name": "description", "type": "text", "optional": false, "description": "Plain-language obligation" },
        { "id": "f_source", "name": "source", "type": "tuple[text,quote]", "optional": false, "description": "Rule text + originating quote" },
        { "id": "f_severity", "name": "severity", "type": "int", "optional": false, "description": "1-5 risk weight" }
      ]
    },
    {
      "id": "m_combined",
      "name": "EvaluationInput",
      "description": "Auto-generated by the Combine Inputs step.",
      "auto": true,
      "fields": [
        { "id": "f_company_data", "name": "company_data", "type": "document", "optional": false, "description": "Company outline / filings" },
        { "id": "f_reqs", "name": "company_legal_requirements", "type": "list[model]", "optional": false, "description": "Extracted rules", "ref": "m_rule" }
      ]
    },
    {
      "id": "m_report",
      "name": "LegalConsiderations",
      "description": "Final document of legal considerations for the company.",
      "fields": [
        { "id": "f_summary", "name": "summary", "type": "text", "optional": false, "description": "Executive summary" },
        { "id": "f_rep_rule_id", "name": "rule_id", "type": "text", "optional": false, "description": "Rule assessed" },
        { "id": "f_compliant", "name": "compliant", "type": "bool", "optional": false, "description": "Adherence verdict" },
        { "id": "f_rationale", "name": "rationale", "type": "text", "optional": false, "description": "Reasoning" },
        { "id": "f_liability", "name": "liability_usd", "type": "float", "optional": true, "description": "Estimated exposure" }
      ]
    }
  ],
  "modules": [
    {
      "id": "mod_input_legal",
      "kind": "input",
      "label": "Legal Document",
      "inputType": ["text", "pdf"],
      "inputNameContains": "legal_requirements",
      "outStructureId": "m_doc",
      "cached": false,
      "avgMs": 110,
      "avgCostCents": 0
    },
    {
      "id": "mod_doc2text",
      "kind": "doc-to-text",
      "label": "Doc → Text",
      "note": "Parse the contract and annotate its governing purpose.",
      "inStructureId": "m_doc",
      "outStructureId": "m_doc",
      "cached": false,
      "avgMs": 460,
      "avgCostCents": 1
    },
    {
      "id": "mod_extract_rules",
      "kind": "llm",
      "label": "Extract Atomic Rules",
      "note": "text → list[tuple[text, quote]]",
      "inStructureId": "m_doc",
      "outStructureId": "m_rule",
      "outIsList": true,
      "prompt": "Extract the 6 most important atomic, independently verifiable legal rules from the document. For each rule, give a stable rule_id (R-01, R-02, …), a concise plain-language description, the verbatim source quote it came from, and a 1-5 severity. Return at most 6 rules.",
      "model": "deepseek-v3",
      "cached": false,
      "avgMs": 2300,
      "avgCostCents": 6
    },
    {
      "id": "mod_link_quotes",
      "kind": "quote",
      "label": "Link Quotes",
      "auto": true,
      "note": "Auto · AtomicRule → AtomicRule · links LLM quote strings to source spans.",
      "inStructureId": "m_rule",
      "outStructureId": "m_rule",
      "outIsList": true,
      "cached": true,
      "avgMs": 12,
      "avgCostCents": 0
    },
    {
      "id": "mod_sort_rules",
      "kind": "custom-code",
      "label": "Sort Rules by Severity",
      "note": "Custom TS function — deterministic glue step, no LLM cost.",
      "inStructureId": "m_rule",
      "outStructureId": "m_rule",
      "outIsList": true,
      "code": "(rules) => [...rules].sort((a, b) => b.severity - a.severity)",
      "cached": false,
      "avgMs": 5,
      "avgCostCents": 0
    },
    {
      "id": "mod_input_company",
      "kind": "input",
      "label": "Company Data Input",
      "inputType": ["text", "word"],
      "inputNameContains": "company_legal_compliance",
      "outStructureId": "m_doc",
      "cached": false,
      "avgMs": 90,
      "avgCostCents": 0
    },
    {
      "id": "mod_combine",
      "kind": "combine",
      "label": "Combine Inputs",
      "note": "Builds {\"company_data\", \"company_legal_requirements\"}",
      "inStructureId": "m_rule",
      "outStructureId": "m_combined",
      "cached": false,
      "avgMs": 40,
      "avgCostCents": 0
    },
    {
      "id": "mod_assess",
      "kind": "llm",
      "label": "Assess Compliance",
      "note": "Evaluate the company against every rule.",
      "inStructureId": "m_combined",
      "outStructureId": "m_report",
      "outIsList": true,
      "prompt": "Given the company data and the extracted legal requirements, produce one concise assessment per rule: a short summary, the rule_id, a compliant verdict, a brief rationale, and the estimated USD liability exposure if non-compliant.",
      "model": "deepseek-v3",
      "cached": false,
      "avgMs": 3100,
      "avgCostCents": 12
    },
    {
      "id": "mod_output",
      "kind": "output",
      "label": "Legal Considerations",
      "inStructureId": "m_report",
      "outStructureId": "m_report",
      "outIsList": true,
      "cached": false,
      "avgMs": 40,
      "avgCostCents": 0
    }
  ],
  "strategies": [
    { "id": "s_single", "kind": "single-llm", "name": "Single LLM Call", "enabled": true, "model": "deepseek-v3", "accuracy": 76, "latencyMs": 3200, "costCents": 8, "passRate": 90 },
    { "id": "s_rlm", "kind": "rlm", "name": "Recursive LM", "enabled": true, "model": "deepseek-v3", "accuracy": 88, "latencyMs": 9800, "costCents": 21, "passRate": 96 },
    { "id": "s_agent", "kind": "claude-code", "name": "Agent (Frontier)", "enabled": true, "model": "deepseek-v3", "accuracy": 94, "latencyMs": 28400, "costCents": 180, "passRate": 99 },
    { "id": "s_cheap", "kind": "cheap-agent", "name": "Agent (Cheap Model)", "enabled": true, "model": "deepseek-v3", "accuracy": 84, "latencyMs": 18200, "costCents": 14, "passRate": 91 }
  ],
  "docs": [
    { "name": "health_data_legal_requirements.pdf", "type": "text", "label": "inference", "file": "legal/legal_doc_text.txt" },
    { "name": "mediflow_company_legal_compliance.md", "type": "text", "label": "inference", "file": "legal/company_for_assessment.md" }
  ]
}
