  "modules": [
    {
      "id": "mod_assessment_in",
      "kind": "input",
      "label": "Current Assessment",
      "inputType": "json",
      "inputNameContains": "assessment",
      "inputDescription": "Structured assessment JSON (builder_id, peril, construction, storeys, rooms_affected, narrative, coverage_note)",
      "outStructureId": "m_assessment",
      "cached": true,
      "avgMs": 80,
      "avgCostCents": 0,
      "note": "New claim as structured field data — example-select stringifies the whole object as {description}"
    },
    {
      "id": "mod_job_lib_in",
      "kind": "input",
      "label": "Past Job Library",
      "inputType": "json",
      "inputNameContains": "past_job_library",
      "inputDescription": "JSON array of this network's past jobs with denormalized billed_lines",
      "outStructureId": "m_past_job",
      "cached": true,
      "avgMs": 80,
      "avgCostCents": 0,
      "note": "Tenant job library — billed_lines stay on the spine; pass-1 prompt view drops them",
      "outType": {
        "kind": "list",
        "item": { "kind": "ref", "modelId": "m_past_job" }
      }
    },
    {
      "id": "mod_select_jobs",
      "kind": "example-select",
      "label": "Select Comparable Jobs",
      "note": "Pass 1 — cached assessment prefix; uncached {example} is the prompt view (no billed_lines). Spine passthrough keeps billed_lines.",
      "inputDescription": "list[PastJob] from the job library JSON",
      "inStructureId": "m_past_job",
      "outStructureId": "m_selected_job",
      "exampleContextLabel": "Current Assessment",
      "exampleReasonField": "selection_reason",
      "examplePromptView": "SELECT id, builder_id, title, peril, construction, storeys, rooms_affected, narrative FROM past_job",
      "prompt": "Find past assessments from THIS builder that are useful analogues for scoping the current claim.\n\nMatch builder_id exactly. Prefer the same peril, construction, storeys, and affected rooms. Reject other builders and unrelated trades (decks, owner upgrades, office fitouts).\n\nCURRENT ASSESSMENT:\n\n{description}\n\nCANDIDATE PAST JOB:\n\n{example}",
      "model": "deepseek-v4",
      "costLimitCents": 100,
      "cached": true,
      "avgMs": 2200,
      "avgCostCents": 3,
      "outType": {
        "kind": "list",
        "item": { "kind": "ref", "modelId": "m_selected_job" }
      }
    },
    {
      "id": "mod_explode_lines",
      "kind": "custom-code",
      "label": "Explode Analogue Lines",
      "note": "Flatten selected jobs' billed_lines; unique by work_item_id. Quantity/rate stay on the row for compose.",
      "inputDescription": "list[SelectedPastJob] with denormalized billed_lines",
      "inStructureId": "m_selected_job",
      "outStructureId": "m_candidate_line",
      "cached": true,
      "avgMs": 8,
      "avgCostCents": 0,
      "fallbackList": [
        {
          "typescript": "(jobs) => { const seen = new Map(); for (const j of jobs) { for (const line of j.billed_lines ?? []) { if (!seen.has(line.work_item_id)) seen.set(line.work_item_id, { ...line, source_job_id: j.id }); } } return [...seen.values()]; }"
        }
      ],
      "outType": {
        "kind": "list",
        "item": { "kind": "ref", "modelId": "m_candidate_line" }
      }
    },
    {
      "id": "mod_select_lines",
      "kind": "example-select",
      "label": "Select Applicable Lines",
      "note": "Pass 2 — cached assessment prefix; prompt view drops quantity/unit_rate (uncached noise). Kept rows still have rates for compose.",
      "inputDescription": "list[CandidateLine] exploded from selected analogues",
      "inStructureId": "m_candidate_line",
      "outStructureId": "m_selected_line",
      "exampleContextLabel": "Current Assessment",
      "exampleReasonField": "selection_reason",
      "examplePromptView": "SELECT work_item_id, code, trade, description, unit, source_job_id FROM candidate_line",
      "prompt": "Decide whether this billed line from a comparable past job should appear on the preliminary estimate.\n\nKeep lines the current damage would require. Drop lines specific to a different room, peril, or construction. Do not use quantity or rate to decide relevance.\n\nCURRENT ASSESSMENT:\n\n{description}\n\nCANDIDATE LINE:\n\n{example}",
      "model": "deepseek-v4",
      "costLimitCents": 200,
      "cached": true,
      "avgMs": 4000,
      "avgCostCents": 8,
      "outType": {
        "kind": "list",
        "item": { "kind": "ref", "modelId": "m_selected_line" }
      }
    },
    {
      "id": "mod_assemble",
      "kind": "assemble",
      "label": "Assemble Estimate Request",
      "note": "Zip assessment + selected jobs + selected lines for the compose step.",
      "inputDescription": "Filtered SelectedLine rows",
      "inStructureId": "m_selected_line",
      "outStructureId": "m_estimate_req",
      "inType": {
        "kind": "list",
        "item": { "kind": "ref", "modelId": "m_selected_line" }
      },
      "outType": {
        "kind": "ref",
        "modelId": "m_estimate_req"
      },
      "assembleBindings": {
        "assessment": { "kind": "state", "label": "Current Assessment" },
        "selected_jobs": { "kind": "state", "label": "Select Comparable Jobs" },
        "selected_lines": { "kind": "spine" }
      },
      "cached": true,
      "avgMs": 5,
      "avgCostCents": 0
    },
    {
      "id": "mod_compose",
      "kind": "llm",
      "label": "Compose Preliminary Estimate",
      "note": "Compose from retrieved analogue lines — do not invent SKUs or rates. Output is for human review.",
      "inputDescription": "EstimateRequest with assessment, selected_jobs, and selected_lines",
      "inStructureId": "m_estimate_req",
      "outStructureId": "m_estimate",
      "prompt": "Compose a preliminary estimate from retrieved analogue lines. Use selected_lines as the only allowed SKU pool — copy work_item_id, code, description, unit, unit_rate, and source_job_id. Pick quantity from selected_jobs billed_lines for the same work_item_id when several analogues disagree; do not invent catalog rows or rates. amount = quantity * unit_rate. Drop lines that coverage_note would exclude. comparable_job_ids must be the selected_jobs ids. review_notes must flag gaps, coverage calls, and that a human must sign off. Output title, comparable_job_ids, line_items, total_ex_gst, review_notes.",
      "model": "deepseek-v4",
      "cached": true,
      "avgMs": 1800,
      "avgCostCents": 4
    },
    {
      "id": "mod_output",
      "kind": "output",
      "label": "Estimate Output",
      "inputDescription": "PreliminaryEstimate for human review",
      "inStructureId": "m_estimate",
      "outStructureId": "m_estimate",
      "cached": true,
      "avgMs": 40,
      "avgCostCents": 0,
      "note": ""
    }
  ],
