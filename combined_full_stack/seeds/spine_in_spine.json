          "type": "text",
          "optional": false,
          "description": "text | int | float | bool"
        },
        {
          "id": "f_field_opt",
          "name": "optional",
          "type": "bool",
          "optional": false,
          "description": "Nullable column"
        },
        {
          "id": "f_field_desc",
          "name": "description",
          "type": "text",
          "optional": false,
          "description": "What the column stores"
        }
      ]
    },
    {
