  ],
  "modules": [
    {
      "id": "mod_blueprint_in",
      "kind": "input",
      "label": "App blueprint",
      "inputType": "json",
      "inputNameContains": "blueprint",
      "inputDescription": "JSON AppBlueprint — tables, pipelines, and pages to compile",
      "outStructureId": "m_app_blueprint",
      "cached": true,
      "avgMs": 40,
      "avgCostCents": 0,
      "note": "Feed a typed app description. Compile steps stay LLM-free.",
      "outType": {
        "kind": "ref",
        "modelId": "m_app_blueprint"
      }
    },
    {
      "id": "mod_compile_schema",
      "kind": "custom-code",
      "label": "Compile schema",
      "inputDescription": "AppBlueprint JSON — compile CREATE TABLE statements",
      "inStructureId": "m_app_blueprint",
      "outStructureId": "m_schema_pack",
      "cached": true,
      "avgMs": 8,
      "avgCostCents": 0,
      "note": "Must stay byte-equal to SPINE_SCHEMA_COMPILE_TS.",
      "fallbackList": [
        {
          "typescript": "(input) => {\n  const blueprint = input && typeof input === \"object\" ? input : {};\n  const tables = Array.isArray(blueprint.tables) ? blueprint.tables : [];\n  const pipelines = Array.isArray(blueprint.pipelines) ? blueprint.pipelines : [];\n  const pages = Array.isArray(blueprint.pages) ? blueprint.pages : [];\n  const sql = tables.map((table) => {\n    const cols = (Array.isArray(table.fields) ? table.fields : []).map((field) => {\n      const sqlType = field.type_name === \"int\" || field.type_name === \"bool\" ? \"INTEGER\"\n        : field.type_name === \"float\" ? \"REAL\" : \"TEXT\";\n      const nulls = field.optional ? \"\" : \" NOT NULL\";\n      return \"  \" + String(field.name) + \" \" + sqlType + nulls;\n    });\n    const body = [\"  id TEXT PRIMARY KEY\"].concat(cols).join(\",\\n\");\n    return \"CREATE TABLE \" + String(table.name || \"table\").toLowerCase() + \" (\\n\" + body + \"\\n);\";\n  }).join(\"\\n\\n\");\n  return {\n    app_name: String(blueprint.app_name || \"Untitled app\"),\n    tagline: String(blueprint.tagline || \"\"),\n    audience: String(blueprint.audience || \"\"),\n    sql_schema: sql || \"-- no tables\",\n    tables,\n    pipelines,\n    pages,\n  };\n}"
        }
      ],
      "inType": {
        "kind": "ref",
        "modelId": "m_app_blueprint"
      },
      "outType": {
        "kind": "ref",
        "modelId": "m_schema_pack"
      }
    },
    {
      "id": "mod_compile_website",
      "kind": "custom-code",
      "label": "Compile website",
      "inputDescription": "SchemaPack — compile hosted HTML, upload form, and share copy",
      "inStructureId": "m_schema_pack",
      "outStructureId": "m_spine_app",
      "cached": true,
      "avgMs": 8,
      "avgCostCents": 0,
      "note": "Must stay byte-equal to SPINE_WEBSITE_COMPILE_TS.",
      "fallbackList": [
        {
          "typescript": "(pack) => {\n  const schema = pack && typeof pack === \"object\" ? pack : {};\n  const appName = String(schema.app_name || \"Untitled app\");\n  const tagline = String(schema.tagline || \"\");\n  const tables = Array.isArray(schema.tables) ? schema.tables : [];\n  const pipelines = Array.isArray(schema.pipelines) ? schema.pipelines : [];\n  const pages = Array.isArray(schema.pages) ? schema.pages : [];\n  const firstTable = tables[0] && tables[0].name ? String(tables[0].name) : \"\";\n  const tableSlot = firstTable ? \"{{table:\" + firstTable + \"}}\" : \"\";\n  const pageHtml = pages.map((page) => {\n    return \"<section class=\\\"hs-feature\\\"><h2>\" + String(page.headline || page.path || \"Page\")\n      + \"</h2><p>\" + String(page.body || \"\") + \"</p></section>\";\n  }).join(\"\\n\");\n  const website_html = [\n    \"<nav class=\\\"hs-nav\\\"><span class=\\\"hs-nav-name\\\">\" + appName + \"</span></nav>\",\n    \"<header class=\\\"hs-hero\\\"><p class=\\\"hs-kicker\\\">Vibe coding platform</p>\",\n    \"<h1 class=\\\"hs-title\\\">\" + tagline + \"</h1>\",\n    \"<p class=\\\"hs-lede\\\">Typed pipelines, a hosted page, and a shared backend.</p></header>\",\n    pageHtml,\n    \"<section class=\\\"hs-run\\\" id=\\\"run\\\">{{run}}</section>\",\n    tableSlot ? \"<section class=\\\"hs-table\\\" id=\\\"data\\\">\" + tableSlot + \"</section>\" : \"\",\n    \"<section class=\\\"hs-output\\\" id=\\\"output\\\">{{output}}</section>\",\n    \"<section class=\\\"hs-pay\\\" id=\\\"pay\\\">{{pay}}</section>\",\n  ].filter(Boolean).join(\"\\n\");\n  const upload_form_html = pipelines.map((pipe) => {\n    return \"<label>\" + String(pipe.name) + \" (\" + String(pipe.input_table) + \")<input type=\\\"file\\\" /></label>\";\n  }).join(\"\\n\") || \"<p>No pipeline uploads</p>\";\n  const typed_ports = pipelines.map((pipe) => ({\n    table_name: String(pipe.input_table || \"\"),\n    pipeline_name: String(pipe.name || \"\"),\n    status: pipe.input_table ? \"exact\" : \"unwired\",\n  }));\n  const share_copy = \"Share \" + appName + \" — website + pipeline + API in one click.\";\n  return {\n    app_name: appName,\n    tagline,\n    sql_schema: String(schema.sql_schema || \"\"),\n    website_html,\n    upload_form_html,\n    share_copy,\n    typed_ports,\n  };\n}"
        }
      ],
      "inType": {
        "kind": "ref",
        "modelId": "m_schema_pack"
      },
      "outType": {
        "kind": "ref",
        "modelId": "m_spine_app"
      }
    },
    {
      "id": "mod_spine_out",
      "kind": "output",
      "label": "Spine app",
      "inputDescription": "Compiled SpineApp — schema, website, uploads, typed ports",
      "inStructureId": "m_spine_app",
      "outStructureId": "m_spine_app",
      "cached": true,
      "avgMs": 20,
      "avgCostCents": 0,
      "note": "The vibe-coded website plus the typed backend in one object.",
      "inType": {
        "kind": "ref",
        "modelId": "m_spine_app"
      },
      "outType": {
        "kind": "ref",
        "modelId": "m_spine_app"
      }
    }
  ],
  "strategies": [
