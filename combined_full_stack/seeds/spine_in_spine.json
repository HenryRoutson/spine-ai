          "name": "sql_schema",
          "type": "text",
          "optional": false,
          "description": "CREATE TABLE statements"
        },
        {
          "id": "f_pack_tables",
          "name": "tables",
          "type": "list[model]",
          "optional": false,
          "description": "Database tables",
          "ref": "m_table_def"
