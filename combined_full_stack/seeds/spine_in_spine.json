        {
          "id": "f_pack_pipelines",
          "name": "pipelines",
          "type": "list[model]",
          "optional": false,
          "description": "Typed pipelines",
          "ref": "m_pipeline_def"
        },
        {
          "id": "f_pack_pages",
          "name": "pages",
          "type": "list[model]",
          "optional": false,
