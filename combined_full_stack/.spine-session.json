        {
          "id": "27f053512eba4141ac8ab91c",
          "kind": "custom-code",
          "label": "Parse Rubric",
          "note": "Convert rubric text to structured Rubric model.",
          "cached": true,
          "avgMs": 0,
          "avgCostCents": 0,
          "inputDescription": "Document with rubric text",
          "inStructureId": "m_builtin_document",
          "outStructureId": "da767da4fa854e09a6c32fee",
          "outType": {
            "kind": "ref",
            "modelId": "da767da4fa854e09a6c32fee"
          },
          "fallbackList": [
            {
              "typescript": "(doc) => {\n  const lines = doc.content.split('\\n').filter(l => l.trim());\n  const questions = lines.map(l => l.split('(')[0].trim());\n  const maxScores = lines.map(l => parseInt(l.match(/\\(max (\\d+)/)?.[1] || '0'));\n  return { questions, max_scores: maxScores };\n}"
            }
          ],
          "maxRunMs": 60000,
          "inType": {
            "kind": "ref",
            "modelId": "m_builtin_document"
          }
        },
