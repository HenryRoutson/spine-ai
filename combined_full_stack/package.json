{
  "name": "combined_full_stack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "bash ../scripts/install-git-hooks.sh",
    "ensure-monaco": "node scripts/ensure_monaco_public.mjs",
    "sync:shared": "bash ../scripts/sync-shared.sh",
    "dev": "npm run sync:shared && npm run ensure-monaco && next dev",
    "build": "npm run sync:shared && npm run ensure-monaco && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck-project": "tsx scripts/typecheck_project.ts",
    "check-openrouter": "node scripts/check_openrouter_key.mjs",
    "benchmark-parallel": "node scripts/benchmark_parallel_openrouter.mjs",
    "sync-seeds": "npx tsx scripts/sync_seeds_to_supabase.ts",
    "check-seeds": "npx tsx scripts/check_seed_docs_sync.ts",
    "generate-expected-outputs": "npx tsx scripts/generate_expected_outputs.ts",
    "sync-pricing": "node scripts/sync_openrouter_pricing.mjs",
    "db:push": "supabase db push",
    "spine": "tsx scripts/spine-cli.ts",
    "spine:demo": "tsx scripts/spine-cli.ts demo",
    "spine:tui": "vite-node -c vite.cli.config.ts scripts/spine-tui.mts --",
    "profile-landing": "tsx scripts/spine-cli.ts profile landing",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:parity": "OPENROUTER_SEED=${OPENROUTER_SEED:-42} vitest run --config vitest.parity.config.ts",
    "seed-llm": "tsx scripts/seed_llm_server.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.87",
    "@assistant-ui/ai-sdk": "^0.0.3",
    "@assistant-ui/react": "^0.15.17",
    "@base-ui/react": "^1.5.0",
    "@langfuse/otel": "^5.10.0",
    "@langfuse/tracing": "^5.10.0",
    "@monaco-editor/react": "^4.7.0",
    "@nangohq/frontend": "^0.71.4",
    "@napi-rs/canvas": "^1.0.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@xyflow/react": "^12.11.5",
    "acorn": "^8.18.0",
    "ai": "^7.0.84",
    "astring": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-dag": "^1.2.2",
    "dotenv": "^17.4.2",
    "fflate": "^0.8.3",
    "ink": "^6.8.0",
    "katex": "^0.18.4",
    "lucide-react": "^1.16.0",
    "mermaid": "^11.16.1",
    "monaco-editor": "^0.55.1",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "pdf-parse": "^2.4.5",
    "pyodide": "^0.27.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "3.8.0",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "rrweb": "^2.0.0-alpha.4",
    "shadcn": "^4.12.0",
    "sonner": "^2.0.7",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.7.3",
    "undici": "^7.28.0",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/estree": "^1.0.9",
    "@types/katex": "^0.16.8",
    "@types/node": "^24",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "postcss": "^8.5",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
}
