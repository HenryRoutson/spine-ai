{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Task",
      "Agent",
      "Skill",
      "NotebookEdit",
      "TodoWrite",
      "mcp__spine-pinpoint__*"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git branch --delete *)",
      "Bash(git branch -m *)",
      "Bash(git branch -M *)",
      "Bash(git branch --move *)",
      "Bash(git branch --rename *)",
      "Bash(git push --delete *)",
      "Bash(git push origin :*)",
      "Bash(rm /*)",
      "Bash(rm -r /*)",
      "Bash(rm -rf /*)",
      "Bash(rm -fr /*)",
      "Bash(rm -R /*)",
      "Bash(rmdir /*)",
      "Bash(unlink /*)",
      "Bash(rm ~/*)",
      "Bash(rm -r ~/*)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -fr ~/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_bash.py",
            "continueOnBlock": true
          }
        ]
      }
    ]
  }
}
