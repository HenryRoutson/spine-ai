STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# SUPABASE
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Postgres password (Settings → Database) — required for `npm run db:push`
SUPABASE_DB_PASSWORD=""

# RATE LIMITING (default: Upstash production backend)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Local dev without Redis — set in combined_full_stack/.env.local:
# RATE_LIMIT_BACKEND=memory

# OPS DASHBOARD (local dashboard/ app — required for sign-in - Run "openssl rand -hex 32" in termal)
DASHBOARD_ACCESS_KEY=""


# LANDING_DEMO_IP_SALT (Run "openssl rand -hex 32" in termal)
LANDING_DEMO_IP_SALT=""

# LANDING DEMO PROXY — shared secret for landing_page → combined_full_stack /api/landing-demo/*
# Required on every hosted deploy (BOTH Vercel projects: landing + Spine). Redeploy both after setting.
# Local `npm run dev:all` uses a dev default.
# Run "openssl rand -hex 32" in terminal
LANDING_DEMO_PROXY_SECRET=""

# NANGO (self-host next to Spine — python3 scripts/setup_local.py nango)
# OAuth callback to register in Slack / Google Cloud: http://localhost:3003/oauth/callback
NANGO_HOST="http://127.0.0.1:3003"
NANGO_SECRET_KEY=""
NANGO_ENCRYPTION_KEY=""

# ACTIVEPIECES CE sidecar (optional — python3 scripts/setup_local.py ap)
# Piece runtime on :3080. Vibe still prefers Nango ids for the vendor popup.
AP_API_URL="http://127.0.0.1:3080"
AP_FRONTEND_URL="http://localhost:3080"
AP_API_KEY=""

# WINDMILL EE (optional — sandboxed n8n + custom-code workers; Spine extras stay in-app)
# WINDMILL_URL=""
# WINDMILL_TOKEN=""
# WINDMILL_WORKSPACE="admins"

# Vibe authoring — default is Windmill-shaped workflow()/task() TypeScript (compileSpineJs → JSON IR).
# SPINE_VIBE_AUTHORING=json
# SPINE_VIBE_HARNESS=1

# COMPETITOR COMPARE — key steps: docs/competitor_compare_keys.md
# Lovable official API is Build-with-URL (no key). REST lov_… is undocumented; MCP is OAuth-only.
LOVABLE_API_KEY=""
LOVABLE_WORKSPACE_ID=""
# Replit official Agent API is MCP OAuth (no static key).
REPLIT_MCP_ACCESS_TOKEN=""
REPLIT_APP_STACK="react_website"
# Base44: copy account API key from workspace Settings → Preferences. Harness reads BASE44_API_KEY only.
BASE44_API_KEY=""

